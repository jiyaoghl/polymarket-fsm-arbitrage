# ==============================================================================
# Polymarket 套利机器人配置模板 (.env)
# ==============================================================================

# ==========================================
# 1. Polymarket CLOB API 认证凭证配置
# ==========================================
# Polymarket 钱包私钥 (用于 EIP-712 签名，模拟模式可留空)
POLX_PK=your_private_key_here
# API 访问公钥 (由 Polymarket 网页端或 client.derive_api_key 生成)
POLX_API_KEY=your_api_key_here
# API 访问密钥
POLX_API_SECRET=your_api_secret_here
# API 访问口令
POLX_API_PASSPHRASE=your_passphrase_here
# 钱包签名类型 (0: 普通私钥/MetaMask/EOA, 1: Polymarket Proxy, 2: Gnosis Safe)
SIGNATURE_TYPE=0
# 代理钱包出资地址 (若使用普通私钥 EOA 留空即可)
FUNDER_ADDRESS=

# ==========================================
# 2. 资金与双资金池风控 (Capital & Dual-Pool Risk)
# ==========================================
# 默认核算基准资金 (USDC)：用于日内最大回撤与盈亏率统计
INITIAL_CAPITAL=100.0
# 模拟盘默认资金池 (USDC)：模拟策略独立使用此资金池 (默认 100.0U)，不受实盘钱包余额影响
PAPER_INITIAL_CAPITAL=1000.0
# 每日最大允许回撤比例：亏损超过本金的 5% 时暂停交易
DAILY_MAX_DRAWDOWN=0.05
# 全账户最大允许同时未对冲的单腿数 (超过后拦截新开仓)
MAX_CONCURRENT_UNHEDGED_TRADES=3
# 首腿单边最大未对冲超时基准 (秒，TTL 强平底线)
LEG1_MAX_UNHEDGED_SECONDS=120
# 临期交割禁止首腿开仓时间 (秒，交割前 45 秒内禁止开新仓)
MIN_TIME_TO_EXPIRY_ENTRY=150

# ==========================================
# 3. 策略与多资产配置 (Strategy & Asset Universe)
# ==========================================
# 支持的市场标的缩写 (逗号分隔，系统将自动滚动寻找 5min 盘口，支持 BTC,ETH,SOL,DOGE,XRP 等)
SUPPORTED_ASSETS=BTC,ETH,SOL

# 最大入场价格：当对方挂单价格高于此值时放弃吃单 (防滑点与吃亏)
ENTRY_MAX_PRICE=0.50
# 最小入场价格：当对方挂单价格低于此值时放弃吃单 (防黑天鹅小概率归零)
ENTRY_MIN_PRICE=0.20
# 再平衡触发价格
REENTRY_TRIGGER_PRICE=0.40
# 默认的单笔订单基础金额 (USDC)
ORDER_AMOUNT=10.0
# 最大 VWAP 滑点容忍度 (0.015 = 1.5%)
MAX_SLIPPAGE_TOLERANCE=0.015

# ==========================================
# 4. 手续费率配置 (Fee Structure)
# ==========================================
# Taker 市价吃单费率 (FOK / 市价) 默认 1%
TAKER_FEE_RATE=0.01
# Maker 挂单费率 (GTC) 默认 0%
MAKER_FEE_RATE=0.00

# ==========================================
# 5. 高保真模拟盘仿真参数 (Paper Trading Fidelity)
# ==========================================
# 模拟 FOK 基础成交率 (0.65 = 65% 概率成交，模拟真实盘口抢单失败)
SIM_BASE_FILL_RATE=0.65
# 模拟最小网络延迟 (毫秒 ms)
SIM_LATENCY_MIN_MS=100
# 模拟最大网络延迟 (毫秒 ms)
SIM_LATENCY_MAX_MS=300
# 模拟最大价格滑点 (0.003 = 0.3% 向上/向下随机滑点)
SIM_SLIPPAGE_MAX=0.003

# ==========================================
# 6. 分资产专属震荡过滤与防爆盾 (Choppy Market Filter)
# 单位均为百分比 % (如 0.30 代表 0.30%)
# ==========================================
# BTC 10分钟 K 线最大振幅与最大净变动阈值
BTC_CHOP_MAX_AMPLITUDE=0.30
BTC_CHOP_MAX_NET_CHANGE=0.20

# ETH 10分钟 K 线最大振幅与最大净变动阈值
ETH_CHOP_MAX_AMPLITUDE=0.45
ETH_CHOP_MAX_NET_CHANGE=0.30

# SOL 10分钟 K 线最大振幅与最大净变动阈值
SOL_CHOP_MAX_AMPLITUDE=0.55
SOL_CHOP_MAX_NET_CHANGE=0.35

# DOGE 10分钟 K 线最大振幅与最大净变动阈值
DOGE_CHOP_MAX_AMPLITUDE=0.65
DOGE_CHOP_MAX_NET_CHANGE=0.40

# XRP 10分钟 K 线最大振幅与最大净变动阈值
XRP_CHOP_MAX_AMPLITUDE=0.50
XRP_CHOP_MAX_NET_CHANGE=0.35

# 通用默认兜底阈值 (未单独配置的资产使用)
CRYPTO_CHOP_MAX_AMPLITUDE=0.35
CRYPTO_CHOP_MAX_NET_CHANGE=0.25

# ==========================================
# 7. EV 评分引擎与仓位风控 (EV Engine & Multi-Strategy)
# ==========================================
# 最低 EV 评分阈值
EV_MIN_SCORE=0.02
# 市场最低流动性要求 (USDC)
EV_MIN_LIQUIDITY=500
# EV 扫描间隔与市场发现扫描间隔 (秒)
EV_SCAN_INTERVAL=15
MARKET_SCAN_INTERVAL=30
# 单市场最大仓位比例 (0.40 = 40%)
MAX_SINGLE_MARKET_PCT=0.40
# 同时最多持仓市场数
MAX_OPEN_MARKETS=3
# 最低现金保留比例 (0.20 = 20%)
MIN_CASH_RESERVE_PCT=0.20
# 单笔最大/最小下单金额 (USDC)
MAX_ORDER_USDC=30.0
MIN_ORDER_USDC=1.0

# 三级熔断阈值 (相对 INITIAL_CAPITAL 的亏损比例)
DRAWDOWN_YELLOW=0.10   # 黄牌：暂停新市场发现
DRAWDOWN_ORANGE=0.20   # 橙牌：停止所有新开仓
DRAWDOWN_RED=0.30      # 红牌：全仓平仓并停止系统

# ==========================================
# 8. 网络、RPC 节点与 CLOB 协议配置
# ==========================================
# 交互的网络 ID (Polygon Mainnet 默认为 137)
CHAIN_ID=137

# Polygon 链上 RPC 节点地址 (用于查询钱包 POL/USDC/pUSD 余额与合约授权)
# 选项 1 [推荐实盘使用]: Alchemy 专属加速节点 (极低延迟 20-80ms，高可用不限流，免费每月 3 亿额度)
#   获取方式: 访问 https://www.alchemy.com 免费注册 -> 创建 Polygon Mainnet App -> 复制 HTTPS URL 填入下方
#   RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/你的Alchemy_API_KEY
# 选项 2 [默认免注册]: 公共高可用节点 (无需配置Key，脚本会自动做多节点容错轮询)
RPC_URL=https://polygon-rpc.com

# Polymarket 中心化订单簿 (CLOB) 与 Gamma 网关端点
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
EIP712_DOMAIN_VERSION=2
EXCHANGE_CONTRACT_V2=0xE111180000d2663C0091e4f400237545B87B996B
NEG_RISK_EXCHANGE_CONTRACT_V2=0xe2222d279d744050d28e00520010520000310F59
COLLATERAL_TOKEN_NAME=pUSD

# 代理配置 (国内环境如果直连受限可填入，如 http://127.0.0.1:7890)
HTTP_PROXY=
HTTPS_PROXY=

# 数据库存储路径 (默认保存在 tmp/trading.db)
# DB_PATH=tmp/trading.db

# ==========================================
# 9. 第三方告警通知配置 (可选)
# ==========================================
# Telegram 机器人推送设置
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Discord Webhook 实时战报推送设置 (支持首腿成交、做T止盈、锁仓对冲、强平、链上赎回秒级推送)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_ENABLED=true
DISCORD_MIN_SEVERITY=TRADE

# Discord 双向交互式控制机器人 (支持 !status, !balance, !clean, !pause, !resume, !redeem 等远程指令)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_ADMIN_IDS=123456789012345678,987654321098765432
DISCORD_COMMAND_PREFIX=!

# SMTP 邮件预警设置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_TO=recipient@example.com
