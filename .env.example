# ==============================================================================
# Polymarket FSM 量化高频套利系统生产配置模板 (.env)
# ==============================================================================
# 使用说明：
# 1. 复制本文件为 .env：cp .env.example .env
# 2. 填写您的 CLOB API 凭证与私钥 (实盘必填，模拟盘可留空)
# 3. 配置 Discord Webhook (战报推送) 或 Bot Token (双向交互)
# 4. 根据本金规模调整风控与策略参数
# ==============================================================================

# ==============================================================================
# 1. Polymarket CLOB API 认证与钱包签名配置 (实盘必填)
# ==============================================================================
# Polymarket 钱包私钥 (用于纯原生 EIP-712 签名发单，模拟模式可留空)
POLX_PK=your_private_key_here
# API 访问公钥 (由 Polymarket 网页端或客户端派生)
POLX_API_KEY=your_api_key_here
# API 访问密钥 (Secret)
POLX_API_SECRET=your_api_secret_here
# API 访问口令 (Passphrase)
POLX_API_PASSPHRASE=your_passphrase_here
# 钱包签名类型 (0: 普通私钥/MetaMask/EOA, 1: Polymarket Proxy, 2: Gnosis Safe)
SIGNATURE_TYPE=0
# 代理钱包出资地址 (若使用普通私钥 EOA 留空即可，Proxy 钱包填入主网出资地址)
FUNDER_ADDRESS=

# ==============================================================================
# 2. 资金池与全账户风控生命周期 (Capital & Risk Lifecycle)
# ==============================================================================
# 实盘默认核算基准资金 (USDC)：用于日内最大回撤与盈亏率统计 (系统会自动按链上余额自适应校准)
INITIAL_CAPITAL=100.0
# 模拟盘默认资金池 (USDC)：模拟策略独立使用此资金池 (默认 1000.0U)，不受实盘钱包余额影响
PAPER_INITIAL_CAPITAL=1000.0
# 每日最大允许回撤比例：亏损超过本金的 5% 时暂停交易 (0.05 = 5%)
DAILY_MAX_DRAWDOWN=0.05
# 全账户最大允许同时未对冲的单腿数 (超过后拦截新开仓，防止敞口过度堆叠)
MAX_CONCURRENT_UNHEDGED_TRADES=3
# 首腿单边最大未对冲超时基准 (秒，TTL 动态强平底线)
LEG1_MAX_UNHEDGED_SECONDS=120
# 临期交割禁止首腿开仓时间 (秒，交割前 150 秒内禁止开新仓，防止临期单边流动性穿透)
MIN_TIME_TO_EXPIRY_ENTRY=150
# 风险控制循环扫描间隔 (秒)
RISK_CHECK_INTERVAL=10

# ==============================================================================
# 3. 策略核心与多资产盘口池 (Strategy & Universe)
# ==============================================================================
# 支持的市场标的缩写 (逗号分隔，系统将自动滚动探测 5min 盘口，支持 BTC,ETH,SOL,DOGE,XRP)
SUPPORTED_ASSETS=BTC,ETH,SOL
# 默认单笔订单基础金额 (USDC，撮合引擎硬性要求 size >= 5.0 Shares)
ORDER_AMOUNT=10.0
# 最大入场价格：当对方挂单价格高于此值时放弃吃单 (防滑点与吃亏)
ENTRY_MAX_PRICE=0.50
# 最小入场价格：当对方挂单价格低于此值时放弃吃单 (防黑天鹅小概率归零)
ENTRY_MIN_PRICE=0.20
# 再平衡与追单触发价格
REENTRY_TRIGGER_PRICE=0.40
# 最大 VWAP 滑点容忍度 (0.015 = 1.5%)
MAX_SLIPPAGE_TOLERANCE=0.015

# ==============================================================================
# 4. 手续费率结构配置 (Fee Structure)
# ==============================================================================
# Taker 市价吃单费率 (FOK / 市价吃单) 默认 1%
TAKER_FEE_RATE=0.01
# Maker 限价挂单费率 (GTC / PostOnly) 默认 0% (Polymarket 官方挂单 0 费率)
MAKER_FEE_RATE=0.00

# ==============================================================================
# 5. 高保真模拟盘仿真环境 (Paper Trading Fidelity)
# ==============================================================================
# 模拟 FOK 基础成交率 (0.65 = 65% 概率成交，模拟真实微观盘口抢单失败)
SIM_BASE_FILL_RATE=0.65
# 模拟最小网络延迟 (毫秒 ms)
SIM_LATENCY_MIN_MS=100
# 模拟最大网络延迟 (毫秒 ms)
SIM_LATENCY_MAX_MS=300
# 模拟最大价格滑点 (0.003 = 0.3% 向上/向下随机滑点)
SIM_SLIPPAGE_MAX=0.003

# ==============================================================================
# 6. 分资产专属 K 线防爆盾 (Choppy Market Filter)
# 单位均为百分比 % (如 0.30 代表 0.30%，遇到单边极端行情秒级拦截入场)
# ==============================================================================
# BTC 10分钟 K 线最大振幅与最大净变动阈值
BTC_CHOP_MAX_AMPLITUDE=0.30
BTC_CHOP_MAX_NET_CHANGE=0.20

# ETH 10分钟 K 线最大振幅与最大净变动阈值
ETH_CHOP_MAX_AMPLITUDE=0.45
ETH_CHOP_MAX_NET_CHANGE=0.30

# SOL 10分钟 K 线最大振幅与最大净变动阈值
SOL_CHOP_MAX_AMPLITUDE=0.55
SOL_CHOP_MAX_NET_CHANGE=0.35

# DOGE 10分钟 K 线最大振幅与最大净变动阈值
DOGE_CHOP_MAX_AMPLITUDE=0.65
DOGE_CHOP_MAX_NET_CHANGE=0.40

# XRP 10分钟 K 线最大振幅与最大净变动阈值
XRP_CHOP_MAX_AMPLITUDE=0.50
XRP_CHOP_MAX_NET_CHANGE=0.35

# 通用默认兜底阈值 (未单独配置的资产使用)
CRYPTO_CHOP_MAX_AMPLITUDE=0.35
CRYPTO_CHOP_MAX_NET_CHANGE=0.25

# ==============================================================================
# 7. EV 评分引擎与仓位排他风控 (EV Engine & Position Limits)
# ==============================================================================
# 最低 EV 评分门槛 (仅当全盘口扣费净 Net EV >= 0.02 时才开仓)
EV_MIN_SCORE=0.02
# 市场最低流动性深度要求 (USDC)
EV_MIN_LIQUIDITY=500
# EV 扫描间隔与新市场探测间隔 (秒)
EV_SCAN_INTERVAL=15
MARKET_SCAN_INTERVAL=30
# 单市场最大仓位比例 (0.40 = 40%)
MAX_SINGLE_MARKET_PCT=0.40
# 全系统同时最多持仓市场数
MAX_OPEN_MARKETS=3
# 最低现金安全保留比例 (0.20 = 20%)
MIN_CASH_RESERVE_PCT=0.20
# 单笔最大/最小下单金额 (USDC)
MAX_ORDER_USDC=30.0
MIN_ORDER_USDC=1.0

# 三级动态熔断阈值 (相对初始本金的亏损比例)
DRAWDOWN_YELLOW=0.10   # 黄牌：暂停新市场发现
DRAWDOWN_ORANGE=0.20   # 橙牌：停止所有策略新开仓
DRAWDOWN_RED=0.30      # 红牌：全仓市价清盘并终止系统

# ==============================================================================
# 8. 链上 RPC 节点与 Polymarket 合约配置 (On-Chain Infrastructure)
# ==============================================================================
# 交互的网络 ID (Polygon Mainnet 默认为 137)
CHAIN_ID=137

# Polygon 链上 RPC 节点地址 (用于查询钱包余额、链上 CTF 自动赎回与 Gas 估算)
# 选项 1 [推荐实盘使用]: Alchemy 专属加速节点 (极低延迟 20-80ms，高可用不限流，免费每月 3 亿额度)
#   获取方式: 访问 https://www.alchemy.com 免费注册 -> 创建 Polygon Mainnet App -> 复制 HTTPS URL 填入下方
#   RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/你的Alchemy_API_KEY
# 选项 2 [默认免注册]: 公共高可用节点 (无需配置Key，系统内置多候选节点自动故障转移)
RPC_URL=https://polygon-rpc.com

# Polymarket 中心化订单簿 (CLOB) 与 Gamma 网关端点
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
EIP712_DOMAIN_VERSION=2
EXCHANGE_CONTRACT_V2=0xE111180000d2663C0091e4f400237545B87B996B
NEG_RISK_EXCHANGE_CONTRACT_V2=0xe2222d279d744050d28e00520010520000310F59
COLLATERAL_TOKEN_NAME=pUSD

# 数据库存储路径 (默认自动固化在 data/trading.db，具备 WAL 高并发模式)
# DB_PATH=data/trading.db

# 网络代理设置 (若直连 Polymarket 受限可填入，如 http://127.0.0.1:7890)
HTTP_PROXY=
HTTPS_PROXY=

# ==============================================================================
# 9. Discord 实时战报推送与双向交互机器人 (Discord Integrations)
# ==============================================================================
# A. Discord Webhook 实时战报推送 (单向图文战报：开仓、做T止盈、锁仓对冲、强平、链上赎回)
# 获取方式：在 Discord 频道设置 -> 整合 -> 创建 Webhook -> 复制 Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_ENABLED=true
DISCORD_MIN_SEVERITY=TRADE   # INFO | TRADE | WARNING | CRITICAL

# B. Discord 双向交互控制机器人 (支持在频道输入 !status, !balance, !clean, !pause, !resume, !redeem)
# 获取方式：在 https://discord.com/developers/applications 创建 Bot 并开启 MESSAGE CONTENT INTENT
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# 管理员用户 ID 白名单 (逗号分隔，仅白名单用户可执行 !clean, !pause 等高危指令)
DISCORD_ADMIN_IDS=123456789012345678,987654321098765432
# 指令前缀 (默认为 !)
DISCORD_COMMAND_PREFIX=!

# ==============================================================================
# 10. 其它第三方告警 (可选)
# ==============================================================================
# Telegram 机器人推送设置
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP 邮件预警设置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

