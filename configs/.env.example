# ==============================================================================
# Polymarket 套利机器人配置模板 (.env)
# ==============================================================================

# ==========================================
# 1. Polymarket CLOB API 认证凭证配置
# ==========================================
# Polymarket 钱包私钥 (用于 EIP-712 签名，模拟模式可留空)
POLX_PK=your_private_key_here
# API 访问公钥 (由 Polymarket 网页端或 client.derive_api_key 生成)
POLX_API_KEY=your_api_key_here
# API 访问密钥
POLX_API_SECRET=your_api_secret_here
# API 访问口令
POLX_API_PASSPHRASE=your_passphrase_here
# 钱包签名类型 (0: 普通私钥/MetaMask/EOA, 1: Polymarket Proxy, 2: Gnosis Safe)
SIGNATURE_TYPE=0
# 代理钱包出资地址 (若使用普通私钥 EOA 留空即可)
FUNDER_ADDRESS=

# ==========================================
# 2. 资金与双资金池风控 (Capital & Dual-Pool Risk)
# ==========================================
# 默认核算基准资金 (USDC)：用于日内最大回撤与盈亏率统计
INITIAL_CAPITAL=100.0
# 模拟盘默认资金池 (USDC)：模拟策略独立使用此资金池 (默认 1000.0U)，不受实盘钱包余额影响
PAPER_INITIAL_CAPITAL=1000.0
# 每日最大允许回撤比例：亏损超过本金的 5% 时暂停交易
DAILY_MAX_DRAWDOWN=0.05
# 全账户最大允许同时未对冲的单腿数 (超过后拦截新开仓)
MAX_CONCURRENT_UNHEDGED_TRADES=3
# 首腿单边最大未对冲超时基准 (秒，TTL 强平底线)
LEG1_MAX_UNHEDGED_SECONDS=90
# 临期交割禁止首腿开仓时间 (秒，交割前 45 秒内禁止开新仓)
MIN_TIME_TO_EXPIRY_ENTRY=150

# ==========================================
# 3. 策略与多资产配置 (Strategy & Asset Universe)
# ==========================================
# 支持的市场标的缩写 (逗号分隔，系统将自动滚动寻找 5min 盘口，支持 BTC,ETH,SOL,DOGE,XRP 等)
SUPPORTED_ASSETS=BTC,ETH,SOL

# 最大入场价格：当对方挂单价格高于此值时放弃吃单 (防滑点与吃亏)
ENTRY_MAX_PRICE=0.50
# 最小入场价格：当对方挂单价格低于此值时放弃吃单 (防黑天鹅小概率归零)
ENTRY_MIN_PRICE=0.20
# 再平衡触发价格
REENTRY_TRIGGER_PRICE=0.40
# 默认的单笔订单基础金额 (USDC)
ORDER_AMOUNT=10.0
# 最大 VWAP 滑点容忍度 (0.015 = 1.5%)
MAX_SLIPPAGE_TOLERANCE=0.015

# ==========================================
# 4. 手续费率配置 (Fee Structure)
# ==========================================
# Taker 市价吃单费率 (FOK / 市价) 默认 1%
TAKER_FEE_RATE=0.01
# Maker 挂单费率 (GTC) 默认 0%
MAKER_FEE_RATE=0.00

# ==========================================
# 5. 模拟盘仿真拟真度配置 (Paper Trading Fidelity)
# ==========================================
# 模拟 FOK 基础成交概率 (0.85 代表 85% 概率立即成交，15% 模拟被抢单被拒)
SIM_BASE_FILL_RATE=0.85
# 模拟订单最小网络与撮合延迟 (毫秒)
SIM_LATENCY_MIN_MS=50
# 模拟订单最大网络与撮合延迟 (毫秒)
SIM_LATENCY_MAX_MS=300
# 模拟市价单最大随机滑点价格 (0.005 代表最高 0.5 美分滑点)
SIM_SLIPPAGE_MAX=0.005

# ==========================================
# 6. 网络代理与 RPC 节点配置 (Proxy & RPC)
# ==========================================
# HTTP 代理地址 (国内或部分 VPS 访问 Polymarket/Binance 需配置)
HTTP_PROXY=
# HTTPS 代理地址
HTTPS_PROXY=
# Polygon 链上主 RPC 节点
RPC_URL=https://polygon-rpc.com

# ==========================================
# 7. 动态行情与 K 线防爆盾配置 (Market Volatility Shield)
# ==========================================
# 币安 1m K 线统计学振幅阈值 (百分比，默认 0.35%)
CRYPTO_CHOP_MAX_AMPLITUDE=0.35
# 币安 1m K 线统计学净位移偏离阈值 (百分比，默认 0.15%)
CRYPTO_CHOP_MAX_NET_CHANGE=0.15
# 订单簿不平衡度 (OBI) 极端诱多压迫拦截阈值 (OBI < -0.80 拦截吃单)
OBI_IMBALANCE_THRESHOLD=-0.80

# 各主流币种独立定制防爆盾阈值 (JSON 格式覆盖全局配置)
CRYPTO_CHOP_ASSET_THRESHOLDS={"BTC":{"max_amplitude":0.30,"max_net_change":0.12},"ETH":{"max_amplitude":0.35,"max_net_change":0.15},"SOL":{"max_amplitude":0.50,"max_net_change":0.20}}

# ==========================================
# 8. Maker 做市反卷与迟滞配置 (Anti-Pennying War)
# ==========================================
# 被对手盘反超买一时，随机装死迟滞最小等待时间 (秒)
PEGGING_COOLDOWN_MIN=1.5
# 被对手盘反超买一时，随机装死迟滞最大等待时间 (秒)
PEGGING_COOLDOWN_MAX=3.5
# 装死期满若必须反超，使用的阶梯式跳跃反卷幅度 (价格跃迁)
PEGGING_STEP_JUMP=0.002

# ==========================================
# 9. 系统日志与数据存储 (System Logging & Database)
# ==========================================
# 日志输出等级 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# SQLite 数据库存储路径 (默认保存至 data/trading.db)
DB_PATH=data/trading.db
# 策略配置文件存储路径
STRATEGIES_CONFIG_PATH=configs/strategies.json

# ==========================================
# 10. Web 可视化看板配置 (Dashboard Service)
# ==========================================
# 看板监听绑定主机地址 (0.0.0.0 允许局域网或公网访问)
HOST=0.0.0.0
# 看板 HTTP 监听端口
PORT=8000

# ==========================================
# 11. 消息通知渠道配置 (Alert & Notification Channels)
# ==========================================
# Telegram 预警机器人 Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Telegram 接收预警的目标 Chat ID
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Discord Webhook 预警推送地址
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# SMTP 邮件预警设置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_TO=recipient@example.com