# Polymarket CLOB API 配置
POLX_PK=your_private_key_here
POLX_API_KEY=your_api_key_here
POLX_API_SECRET=your_api_secret_here
POLX_API_PASSPHRASE=your_passphrase_here

# 支持的市场标的 (逗号分隔)
SUPPORTED_ASSETS=BTC,ETH

# 震荡过滤配置 (Choppy Market Filter)
CRYPTO_CHOP_MAX_AMPLITUDE=0.15
CRYPTO_CHOP_MAX_NET_CHANGE=0.10
# 策略配置
ENTRY_MAX_PRICE=0.50
ENTRY_MIN_PRICE=0.20
REENTRY_TRIGGER_PRICE=0.40
STOP_LOSS_TIME=60
ORDER_AMOUNT=10.0

# 风控配置
DAILY_MAX_DRAWDOWN=0.05
INITIAL_CAPITAL=1000.0

# 网络配置
CHAIN_ID=137
RPC_URL=https://polygon-rpc.com

# CLOB API 配置
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# Telegram 通知配置（可选）
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Discord 通知配置（可选）
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# 邮件通知配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_TO=recipient@example.com