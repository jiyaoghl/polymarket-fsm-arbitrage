# ==========================================
# Polymarket CLOB API 认证凭证配置
# ==========================================
# Polymarket 钱包私钥
POLX_PK=your_private_key_here
# API 访问公钥
POLX_API_KEY=your_api_key_here
# API 访问密钥
POLX_API_SECRET=your_api_secret_here
# API 访问口令
POLX_API_PASSPHRASE=your_passphrase_here

# ==========================================
# 策略核心参数配置
# ==========================================
# 支持的市场标的缩写，系统将自动订阅并寻找这些 5min 盘口 (逗号分隔，如 BTC,ETH,SOL)
SUPPORTED_ASSETS=BTC,ETH

# 最大入场价格：当对方挂单价格高于此值时，放弃吃单（防滑点与吃亏）
ENTRY_MAX_PRICE=0.50
# 最小入场价格：当对方挂单价格低于此值时，认为概率过小，放弃吃单
ENTRY_MIN_PRICE=0.20
# 再平衡触发价格（当前未激活或备用）
REENTRY_TRIGGER_PRICE=0.40
# 强平超时秒数（TTL）：单边持仓达到该秒数时，强制市价平仓兜底
STOP_LOSS_TIME=60
# 默认的单笔订单基础金额 (USDC)
ORDER_AMOUNT=10.0

# ==========================================
# 风控与震荡行情过滤配置 (Choppy Market Filter)
# ==========================================
# Crypto K线最大振幅(百分比)：如果近10分钟最高/最低价相差大于此值，判定为单边行情，停止入场（如 0.15 = 0.15%）
CRYPTO_CHOP_MAX_AMPLITUDE=0.15
# Crypto K线最大净变化(百分比)：如果近10分钟开/收盘价相差大于此值，判定为单边行情，停止入场
CRYPTO_CHOP_MAX_NET_CHANGE=0.10

# 每日最大允许回撤比例：亏损超过本金的 5% 时将暂停系统运行
DAILY_MAX_DRAWDOWN=0.05
# 初始分配资金：作为系统核算收益与回撤的基准本金数量
INITIAL_CAPITAL=1000.0

# ==========================================
# 网络与节点配置
# ==========================================
# 交互的网络 ID (Polygon Mainnet 默认为 137)
CHAIN_ID=137
# Polygon RPC 节点地址
RPC_URL=https://polygon-rpc.com

# Polymarket 的中心化订单簿(CLOB)与Gamma网关端点
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# ==========================================
# 第三方消息与通知服务（可选配置）
# ==========================================
# Telegram 机器人推送设置
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Discord Webhook 推送设置
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# SMTP 邮件预警设置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_TO=recipient@example.com