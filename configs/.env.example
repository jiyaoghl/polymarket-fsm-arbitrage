# ==========================================
# Polymarket CLOB API 认证凭证配置
# ==========================================
# Polymarket 钱包私钥 (用于 EIP-712 签名，模拟模式可留空)
POLX_PK=your_private_key_here
# API 访问公钥
POLX_API_KEY=your_api_key_here
# API 访问密钥
POLX_API_SECRET=your_api_secret_here
# API 访问口令
POLX_API_PASSPHRASE=your_passphrase_here

# ==========================================
# 策略核心参数配置
# ==========================================
# 支持的市场标的缩写，系统将自动订阅并寻找这些 5min 盘口 (逗号分隔，如 BTC,ETH)
SUPPORTED_ASSETS=BTC,ETH

# 最大入场价格：当对方挂单价格高于此值时，放弃吃单（防滑点与吃亏）
ENTRY_MAX_PRICE=0.50
# 最小入场价格：当对方挂单价格低于此值时，认为概率过小，放弃吃单
ENTRY_MIN_PRICE=0.20
# 再平衡触发价格（当前未激活或备用）
REENTRY_TRIGGER_PRICE=0.40
# 默认的单笔订单基础金额 (USDC)
ORDER_AMOUNT=10.0

# 首腿单边最大未对冲超时基准（秒，TTL 强平底线，动态 TTL 会在此基础上根据 K 线波动率自动收紧）
LEG1_MAX_UNHEDGED_SECONDS=90
# 全账户最大允许同时未对冲的单腿数（超过后暂停开新仓）
MAX_CONCURRENT_UNHEDGED_TRADES=3

# ==========================================
# 真实手续费率配置 (用于净 EV 锁利计算与模拟盘真实扣费)
# ==========================================
# Taker 市价吃单费率 (FOK / 市价) 默认 1%
TAKER_FEE_RATE=0.01
# Maker 挂单费率 (GTC) 默认 0%
MAKER_FEE_RATE=0.00

# ==========================================
# 高保真模拟盘仿真参数 (仅在 PAPER 模拟模式下生效)
# ==========================================
# 模拟 FOK 基础成交率 (0.65 = 65% 概率成交，模拟真实盘口抢单失败)
SIM_BASE_FILL_RATE=0.65
# 模拟最小网络延迟 (毫秒 ms)
SIM_LATENCY_MIN_MS=100
# 模拟最大网络延迟 (毫秒 ms)
SIM_LATENCY_MAX_MS=300
# 模拟最大价格滑点 (0.003 = 0.3% 向上/向下随机滑点)
SIM_SLIPPAGE_MAX=0.003

# ==========================================
# 分资产专属震荡过滤与防爆盾 (Choppy Market Filter)
# 单位均为百分比 % (如 0.30 代表 0.30%)
# ==========================================
# BTC 10分钟 K 线最大振幅与最大净变动阈值
BTC_CHOP_MAX_AMPLITUDE=0.30
BTC_CHOP_MAX_NET_CHANGE=0.20

# ETH 10分钟 K 线最大振幅与最大净变动阈值
ETH_CHOP_MAX_AMPLITUDE=0.45
ETH_CHOP_MAX_NET_CHANGE=0.30

# 通用默认兜底阈值 (未单独配置的资产使用)
CRYPTO_CHOP_MAX_AMPLITUDE=0.30
CRYPTO_CHOP_MAX_NET_CHANGE=0.20

# ==========================================
# 资金与熔断风控
# ==========================================
# 每日最大允许回撤比例：亏损超过本金的 5% 时将暂停系统运行
DAILY_MAX_DRAWDOWN=0.05
# 初始分配资金：作为系统核算收益与回撤的基准本金数量
INITIAL_CAPITAL=100.0

# ==========================================
# 网络与节点配置
# ==========================================
# 交互的网络 ID (Polygon Mainnet 默认为 137)
CHAIN_ID=137
# Polygon RPC 节点地址
RPC_URL=https://polygon-rpc.com

# Polymarket 的中心化订单簿(CLOB)与Gamma网关端点
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# 代理配置（国内环境如果直连受限可填入，如 http://127.0.0.1:7890）
HTTP_PROXY=
HTTPS_PROXY=

# ==========================================
# 第三方消息与通知服务（可选配置）
# ==========================================
# Telegram 机器人推送设置
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Discord Webhook 推送设置
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# SMTP 邮件预警设置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_TO=recipient@example.com